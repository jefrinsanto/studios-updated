# Frontend environment variables (Vite).
# Only variables prefixed with VITE_ are exposed to the browser.
# Copy to `.env` for local use. NEVER put secrets here — everything in a
# VITE_ variable is public in the built JavaScript.

# Base URL of the deployed backend (no trailing slash).
# Production (set in the Render Static Site → Environment tab):
#   VITE_API_URL=https://your-backend.onrender.com
#
# Local development: leave this EMPTY/commented. The Vite dev server proxies
# /api/* to http://localhost:5000 automatically (see vite.config.js).
#
# NOTE: this is read at BUILD time — redeploy the frontend after changing it.
VITE_API_URL=
