# =====================================================================
# INNOVEXA STUDIOS — backend environment variables
# Copy this file to `.env` for local development. NEVER commit `.env`.
# On Render, add these in: Service → Environment.
# =====================================================================

# ---------- Server ----------
# Render sets PORT automatically — do not set it there.
PORT=5000

# Frontend origin(s) allowed by CORS. Comma-separated, no trailing slash.
# Local:      http://localhost:5173
# Production: https://your-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# ---------- MongoDB ----------
# Local: mongodb://127.0.0.1:27017/innovexa-studios
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/innovexa-studios?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/innovexa-studios

# ---------- Gmail SMTP ----------
# Requires 2-Step Verification on the Gmail account, then create an
# App Password at https://myaccount.google.com/apppasswords
# (16 characters, enter WITHOUT spaces). Do NOT use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Address that receives new lead notifications
NOTIFY_EMAIL=innovexastudios2026@gmail.com

# ---------- OPTIONAL: Resend (HTTPS email API) ----------
# Render FREE web services block SMTP ports (25/465/587), so Gmail SMTP only
# works there on a paid instance. On the free plan, create a free account at
# https://resend.com, make an API key, and set it below — it takes priority
# over SMTP. (Without a verified domain, Resend only delivers to the email
# address you signed up with, so sign up with the NOTIFY_EMAIL address.)
# RESEND_API_KEY=
# RESEND_FROM=INNOVEXA STUDIOS <onboarding@resend.dev>
